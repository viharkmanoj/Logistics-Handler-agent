# Logistics Handler AI Agent - Environment Configuration
# Copy this file to .env and configure as needed.

# ==============================================================================
# Google ADK (Agent Development Kit) & Google Gemini Configuration
# ==============================================================================
# Google Gemini API Key (Optional for Demo Mode, Required for Live Google ADK Gemini Mode)
# Leave blank or omit to run in fully functional local Demo Mode.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Google Gemini Model configuration (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Maps Routes API Key (If omitted, uses simulated distance matrix fallback)
GOOGLE_MAPS_API_KEY=

# Database Configuration
LOGISTICS_DB_PATH=data/logistics.db

# Application Mode: auto | ai | demo
AGENT_MODE=auto

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Self-Healing & Failure Simulation (set to 0 for normal operation, or an integer N to simulate N consecutive transient failures)
SIMULATE_TRANSIENT_FAILURES=0
