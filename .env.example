# Logistics Handler AI Agent - Environment Configuration
# Copy this file to .env and configure as needed.

# OpenAI API Key (Optional for Demo Mode, Required for Live OpenAI Agents SDK Mode)
# Leave blank or omit to run in fully functional local Demo Mode.
OPENAI_API_KEY=

# OpenAI Model configuration
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
LOGISTICS_DB_PATH=data/logistics.db

# Application Mode: auto | ai | demo
AGENT_MODE=auto

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Self-Healing & Failure Simulation (set to 0 for normal operation, or an integer N to simulate N consecutive transient failures)
SIMULATE_TRANSIENT_FAILURES=0
